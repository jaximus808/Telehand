# MongoDB connection string (users + registered arms are stored here)
DB_CONNECT=mongodb://localhost:27017/robotichand

# Secret used to sign user JWTs
TOKEN_SECRET=change-me

# Shared secret a NodeMCU must present when registering an arm (/api/arm/register)
ARM_PASSWORD=change-me

# Shared secret a fleet server must present on /server/auth/* routes
FLEET_SERVER_PASSWORD=change-me
